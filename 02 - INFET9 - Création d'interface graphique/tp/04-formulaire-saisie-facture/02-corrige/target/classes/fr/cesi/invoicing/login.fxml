<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="fr.cesi.invoicing.LoginController"
      spacing="12"
      alignment="CENTER">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30" />
    </padding>
    <Label text="Application de facturation" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
    <TextField fx:id="usernameField" promptText="Identifiant" />
    <PasswordField fx:id="passwordField" promptText="Mot de passe" />
    <Label fx:id="errorLabel" text="Identifiant ou mot de passe incorrect" style="-fx-text-fill: red;" visible="false" managed="false" />
    <Button fx:id="loginButton" text="Se connecter" onAction="#handleLogin" />
</VBox>
