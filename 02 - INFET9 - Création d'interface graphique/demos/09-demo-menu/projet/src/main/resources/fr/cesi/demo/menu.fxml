<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="fr.cesi.demo.MenuController">
    <MenuBar>
        <menus>
            <Menu text="Facture">
                <items>
                    <MenuItem text="Aller à C" onAction="#handleGoToC" />
                    <MenuItem text="Aller à D" onAction="#handleGoToD" />
                    <MenuItem text="Option 3 (bientôt)" disable="true" />
                </items>
            </Menu>
            <Menu text="Aide">
                <items>
                    <MenuItem text="À propos (bientôt)" disable="true" />
                </items>
            </Menu>
        </menus>
    </MenuBar>
</VBox>
