{
  "name": "slidev-theme-cesi-eloc",
  "version": "1.1.0",
  "private": true,
  "description": "Thème des slides de cours : copie de slidev-theme-eloc 1.1.0 (MIT, voir LICENSE et README.md), polices en local.",
  "keywords": ["slidev-theme", "slidev"],
  "license": "MIT",
  "engines": { "slidev": ">=51.0.0" },
  "slidev": {
    "colorSchema": "both",
    "highlighter": "shiki",
    "defaults": {
      "colorSchema": "auto",
      "routerMode": "hash",
      "canvasWidth": 1580,
      "selectable": true,
      "fonts": {
        "sans": "Inter",
        "mono": "Fira Code",
        "provider": "none"
      }
    }
  }
}
